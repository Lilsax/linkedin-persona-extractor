# Copy this file to .env and fill values before running the app

# BrightData API key - required if you want to fetch real LinkedIn pages (mock=False)
BRIGHT_DATA=

# Google Generative API key - optional. If not set, the app will try Ollama locally.
GOOGLE_API_KEY=

# Optional overrides (defaults are safe, keep only if you need custom endpoints)
MOCK_GIST_URL=
BRIGHTDATA_TRIGGER_URL=
BRIGHTDATA_SNAPSHOT_BASE=

# Tavily API key (required for search tool)
TAVILY_API_KEY=

# The port the Flask app will bind to (default: 5000)
PORT=5000
